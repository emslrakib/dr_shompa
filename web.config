<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy configuration for DrShompa.
  Prerequisites: IIS, URL Rewrite 2.x, and ARR with proxy enabled at server level.
  The Node.js process must already be running on 127.0.0.1:5000.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="DrShompa reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:1}" appendQueryString="true" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>