# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored — never commit real credentials.
# ---------------------------------------------------------------------------

# Web server
PORT=5000

# SQL Server connection
DB_SERVER=localhost
DB_NAME=DrShompaDB
DB_USER=your_sql_user
DB_PASSWORD=your_sql_password
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ---------------------------------------------------------------------------
# OPTIONAL admin protection.
# Leave both blank to keep the CMS open (default local behaviour).
# Set both to lock down /admin, patient records and content editing
# (the public website and the booking form stay open either way).
# ---------------------------------------------------------------------------
# ADMIN_USER=
# ADMIN_PASS=
