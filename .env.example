# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored — never commit real credentials.
#
# NOTE: for a new machine, prefer appsettings.json instead.
# Copy appsettings.example.json to appsettings.json — that single file
# covers every setting below and beats conflicting .env values.
# ---------------------------------------------------------------------------

# Web server. Set NODE_ENV=production on the deployed server.
NODE_ENV=development
PORT=5000
# true (default) = create any missing table / default content from setup_db.sql
# when the server starts. Set false to manage the schema only by hand.
DB_AUTO_MIGRATE=true
# Set true only when HTTPS is terminated by a trusted reverse proxy (IIS/Nginx/Cloudflare).
TRUST_PROXY=false
# Comma-separated extra browser origins allowed to call the API. Leave empty for same-origin only.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# PostgreSQL connection.
#
# Cloud / free hosting (Neon, Supabase, Render): paste the connection string
# from the dashboard — it already carries sslmode=require, so TLS is switched
# on automatically.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://username:password@host:5432/dbname?sslmode=require

# Local PostgreSQL (no TLS): use the standard libpq variables instead.
PGHOST=localhost
PGPORT=5432
PGDATABASE=DrShompaDB
PGUSER=postgres
PGPASSWORD=your_postgres_password
# TLS: leave empty to decide from DATABASE_URL, set false for a local server.
DB_SSL=false

# ---------------------------------------------------------------------------
# OPTIONAL admin protection.
# Leave both blank to keep the CMS open (default local behaviour).
# Set both to switch the /login screen on and lock down /admin, patient records
# and content editing (the public website and the booking form stay open).
# ---------------------------------------------------------------------------
# ADMIN_USER=admin
# ADMIN_PASS=choose-a-long-unique-password

# Optional: keeps signed-in sessions valid across server restarts.
# If left unset it is derived from the admin credentials.
# In production this is required and must be a random value of 32+ characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=

# Optional appointment reminder channels. Keep REMINDER_DRY_RUN=true until tested.
REMINDER_DRY_RUN=true
# SMS_API_URL=
# SMS_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# CLINIC_EMAIL=
